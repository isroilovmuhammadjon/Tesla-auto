{
  "name": "street-racing-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Street Racing 3D — Three.js racing game packaged for Android with Capacitor",
  "scripts": {
    "serve": "python3 -m http.server 8765 -d www",
    "android:add": "cap add android && node scripts/patch-android.mjs",
    "android:sync": "cap sync android",
    "android:build": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
